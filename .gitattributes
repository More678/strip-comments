# Keep LF in the repository regardless of the committer's core.autocrlf.
# build.sh with CRLF fails on the Linux CI runner with "bad interpreter".
* text=auto eol=lf

*.sh text eol=lf
*.go text eol=lf
*.yml text eol=lf
*.mod text eol=lf
*.md text eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Release artifacts, if ever committed, are opaque.
*.exe binary
